<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- App Sandbox. A browser runs untrusted code from every site you visit; WebKit's own
       process split is the first wall and this is the second. Everything below is the
       minimum needed to put it back into a working browser. -->
  <key>com.apple.security.app-sandbox</key><true/>

  <!-- Outbound HTTP(S). network.server is for Vane's own 127.0.0.1 listeners: the
       ChatGPT sign-in OAuth callback (ChatGPTSignIn.swift) and the BrowserChecks loopback
       fixture the release smoke runs. WebRTC does not need it; WebKit's networking process
       owns those sockets. -->
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>

  <!-- Camera and microphone need resource eligibility in addition to Vane's site
       decisions and the user's separate macOS authorization. -->
  <key>com.apple.security.device.camera</key><true/>
  <key>com.apple.security.device.microphone</key><true/>
  <!-- Retain audio-input for Hardened Runtime and older sandbox configurations. -->
  <key>com.apple.security.device.audio-input</key><true/>

  <!-- WebKit geolocation needs sandbox access as well as the site decision. This
       entitlement does not grant the user's separate Location Services authorization. -->
  <key>com.apple.security.personal-information.location</key><true/>

  <!-- WebHID (WebHID.swift): opening an HID interface the user picked for a site. Despite
       the name this is the entitlement that lets the sandbox open IOHIDLibUserClient,
       whatever the device's transport. Measured on macOS 27 with a probe signed with these
       entitlements: without it IOHIDDeviceOpen fails with kIOReturnNotPermitted; with it
       the open works. device.bluetooth alone does not unlock it. Listing devices and
       reading report descriptors only reads the IOKit registry and needs no entitlement. -->
  <key>com.apple.security.device.usb</key><true/>

  <!-- ⌘P on a page. -->
  <key>com.apple.security.print</key><true/>

  <!-- WKDownload writes straight to ~/Downloads (Downloads.swift), which is outside the
       container. -->
  <key>com.apple.security.files.downloads.read-write</key><true/>

  <!-- The NSOpenPanel pickers: extension folders, filter lists, password imports/exports,
       and other files the user explicitly selects. -->
  <key>com.apple.security.files.user-selected.read-write</key><true/>

  <!-- Only the authenticated XPC installer publishes, recovers and cleans up updates.
       The browser can inspect installed versions and pending transaction records. -->
  <key>com.apple.security.temporary-exception.files.absolute-path.read-only</key>
  <array>
    <string>/Applications/</string>
  </array>

  <!-- ...and the per-user one beside it, for anyone who keeps their apps in ~/Applications.
       A different key because the sandbox spells a home-relative path differently; the same
       one directory's worth of access. -->
  <key>com.apple.security.temporary-exception.files.home-relative-path.read-only</key>
  <array>
    <string>/Applications/</string>
    <!-- Automatic browser import: known source locations only, always read-only.
         Scans run on explicit import/onboarding entry; Keychain and macOS privacy
         consent remain separate. No blanket home or Library access. -->
    <string>/Library/Application Support/Arc/</string>
    <string>/Library/Application Support/Google/Chrome/</string>
    <string>/Library/Application Support/Chromium/</string>
    <string>/Library/Application Support/Microsoft Edge/</string>
    <string>/Library/Application Support/BraveSoftware/Brave-Browser/</string>
    <string>/Library/Application Support/Vivaldi/</string>
    <string>/Library/Application Support/com.operasoftware.Opera/</string>
    <string>/Library/Application Support/Firefox/Profiles/</string>
    <string>/Library/Application Support/zen/Profiles/</string>
    <string>/Library/Application Support/Orion/</string>
    <string>/Library/Safari/</string>
  </array>

  <!-- ...and this is what makes those picks survive a relaunch. Without it a folder the
       user chose is readable for exactly one launch, and every extension silently fails to
       load on the next one. See `ScopedPaths` in Profiles.swift. -->
  <key>com.apple.security.files.bookmarks.app-scope</key><true/>

  <!-- Safe Browsing. WebKit asks Safari's service whether a URL is a known phishing or
       malware site; the sandbox denies the lookup by name
       ("deny(1) mach-lookup com.apple.Safari.SafeBrowsing.Service") and the deceptive-site
       interstitial silently stops appearing. Sandboxing a browser must not cost it a
       security feature, so this is granted back explicitly.

       Picture in Picture. The floating window is not ours: WebKit hands the video to
       PIPAgent (/System/Library/CoreServices/PIPAgent.app, mach service com.apple.PIPAgent)
       and the sandbox denies that lookup silently — the page says "playing in picture in
       picture", the engine reports the mode change, and no window ever appears. Measured
       with a probe signed with these entitlements: without the name, no window; with it,
       the "Picture in Picture" window comes and goes with the mode. -->
  <key>com.apple.security.temporary-exception.mach-lookup.global-name</key>
  <array>
    <string>com.apple.Safari.SafeBrowsing.Service</string>
    <string>com.apple.PIPAgent</string>
  </array>

  <!-- Deliberately NOT here:
       * keychain-access-groups — needs $(AppIdentifierPrefix), i.e. a Team ID, which this
         ad-hoc-signed build does not have. A sandboxed app reaches its OWN keychain items
         without it; the entitlement is only for sharing a group between apps. Add
         "$(AppIdentifierPrefix)io.github.notnaki.vane" the day a Developer ID exists.
       * cs.allow-jit — WebKit JITs in its own XPC services; in-process JSContext falls
         back to the interpreter under Hardened Runtime (measured).
       * downloads access beyond ~/Downloads, or blanket home/Library exceptions. -->
</dict>
</plist>
